# Copy to .env and edit. Never commit the real .env file.

# Long random value to read leads at /api/admin/leads (leave empty to disable)
KAVACH_ADMIN_TOKEN=

# SQLite file for scans and leads
KAVACH_DB_PATH=./kavach.db

# Scans allowed per visitor per hour
KAVACH_SCANS_PER_HOUR=5

# Seconds to reuse a result for the same domain
KAVACH_CACHE_SECONDS=600

# Issues shown free before an email is given
KAVACH_FREE_FINDINGS=3
